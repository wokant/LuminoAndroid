# Source control stuff
wip() {
  git commit -a -m WIP
}
newcommit () {
  wip
}
squish() {
  git status && git commit -a --amend -C HEAD
}
show() {
  git show
}
gs() {
  git status
}
ga() {
  git add ~/dev/Rally
}
# Checkout git checkout <commit_hash>
glog() {
  git log --pretty=format:"%h $ad- %s [%an]"
}
ad() {
  arc diff HEAD^
}
interactiveRebase() {
  git rebase -i origin/master
}
rallypull() {
    git fetch origin master:master  && git fetch origin stable:stable
}
arcupdate() {
    arc diff -m "update after rebase"
}
